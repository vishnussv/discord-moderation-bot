# Copy this file to .env and fill it in. NEVER share your real token.
DISCORD_TOKEN=your_bot_token_here

# Optional — you can also set these with /setwelcome and /setlog in Discord
WELCOME_CHANNEL_ID=
LOG_CHANNEL_ID=
WELCOME_ROLE_ID=

# Optional — your server ID, for instant slash-command sync while testing.
# Leave blank for global sync (can take up to 1 hour to appear).
GUILD_ID=
